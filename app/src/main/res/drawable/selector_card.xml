<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/card_bg_focused" />
            <stroke android:width="3dp" android:color="@color/focus_highlight" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/card_bg_normal" />
            <stroke android:width="1dp" android:color="#222834" />
        </shape>
    </item>
</selector>
