<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#232C3B" />
            <stroke android:width="2dp" android:color="@color/focus_highlight" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#161A22" />
            <stroke android:width="1dp" android:color="#283244" />
        </shape>
    </item>
</selector>
